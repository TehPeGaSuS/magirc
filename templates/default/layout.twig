<!DOCTYPE html>
<html lang="{{ locale|replace({'_': '-'}) }}" data-theme-default="{{ cfg.display.theme_default|default('system') }}" data-page-size="{{ cfg.display.page_size|default(50) }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{% if title is defined %}{{ title }} · {% endif %}{{ cfg.network.name }}{% endblock %}</title>
<meta name="description" content="{{ 'Live statistics of the %s IRC network: users, channels, servers and activity.'|t|format(cfg.network.name) }}">
<link rel="icon" href="{{ cfg.base_path }}/assets/img/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ cfg.base_path }}/assets/css/magirc.css?v={{ cfg.version }}">
<script>
/* Apply the theme before paint to avoid a flash. */
(function () {
  try {
    var pref = localStorage.getItem('magirc-theme');
    var def = document.documentElement.getAttribute('data-theme-default') || 'system';
    var query = new URLSearchParams(location.search).get('theme');
    var theme = (query === 'dark' || query === 'light') ? query : (pref || def);
    if (theme === 'system') theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    document.documentElement.setAttribute('data-theme', theme);
  } catch (e) {}
})();
</script>
</head>
<body data-i18n-pager="{{ 'Pages'|t }}" data-i18n-prev="{{ 'Previous'|t }}" data-i18n-next="{{ 'Next'|t }}">
<a class="skip" href="#main">{{ 'Skip to content'|t }}</a>
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="{{ url_for('home') }}">{{ cfg.network.name }}</a>
    <nav class="nav" aria-label="{{ 'Main'|t }}">
      <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-list">{{ 'Menu'|t }}</button>
      <ul id="nav-list" class="nav__list">
        {% set here = current_url() %}
        {% for name, label in {
          'network': 'Network'|t, 'servers': 'Servers'|t, 'channels': 'Channels'|t,
          'users': 'Users'|t, 'operators': 'Operators'|t } %}
          <li><a href="{{ url_for(name) }}"{% if here starts with url_for(name) and (name != 'network' or here == url_for(name)) %} aria-current="page"{% endif %}>{{ label }}</a></li>
        {% endfor %}
        {% if cfg.chanstats %}
          <li><a href="{{ url_for('activity') }}"{% if here starts with url_for('activity') %} aria-current="page"{% endif %}>{{ 'Activity'|t }}</a></li>
        {% endif %}
        {% if cfg.geoip %}
          <li><a href="{{ url_for('network.countries') }}"{% if here == url_for('network.countries') %} aria-current="page"{% endif %}>{{ 'Countries'|t }}</a></li>
        {% endif %}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="{{ 'Switch between light and dark theme'|t }}" title="{{ 'Light / dark'|t }}">
      <svg class="theme-toggle__sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="theme-toggle__moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </div>
</header>

<main id="main" class="container">
{% block content %}{% endblock %}
</main>

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>
      {% if cfg.network.server and (cfg.network.port_tls or cfg.network.port) %}
        {{ 'Connect:'|t }} <code>{{ cfg.network.server }}:{{ cfg.network.port_tls ?: cfg.network.port }}</code>
        {% if cfg.network.port_tls %}<span class="muted">(TLS)</span>{% endif %}
      {% elseif cfg.network.server %}
        {{ 'Connect:'|t }} <code>{{ cfg.network.server }}</code>
      {% endif %}
      {% if cfg.network.webchat %} · <a href="{{ webchat_url() }}">{{ 'Webchat'|t }}</a>{% endif %}
    </p>
    <p class="muted">
      {% if snapshot_time is defined %}{{ 'Data from %s'|t|format(snapshot_time|ago) }} · {% endif %}
      {% if cfg.display.show_version %}<a href="https://github.com/TehPeGaSuS/magirc">MagIRC {{ cfg.version }}</a>{% endif %}
    </p>
  </div>
</footer>

<script src="{{ cfg.base_path }}/assets/vendor/echarts.min.js" defer></script>
<script src="{{ cfg.base_path }}/assets/js/magirc.js?v={{ cfg.version }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
