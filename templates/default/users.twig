{% extends 'layout.twig' %}

{% block content %}
<h1>{{ 'Users'|t }}</h1>
<p class="lead">{{ _n('%s user online.', '%s users online.', users|length)|format(users|length|format_number) }}</p>
<p><label for="filter" class="visually-hidden">{{ 'Filter users'|t }}</label><input id="filter" class="filter" type="search" placeholder="{{ 'Filter by nick, host or name'|t }}" data-filter-table="#users"></p>
<table id="users" class="table table--sortable">
  <thead><tr>
    <th data-sort="asc">{{ 'Nick'|t }}</th>
    <th>{{ 'Host'|t }}</th>
    {% if cfg.display.show_realname %}<th>{{ 'Real name'|t }}</th>{% endif %}
    <th>{{ 'Server'|t }}</th>
    {% if cfg.geoip %}<th>{{ 'Country'|t }}</th>{% endif %}
    <th class="num">{{ 'Channels'|t }}</th>
    <th>{{ 'Online for'|t }}</th>
  </tr></thead>
  <tbody>
  {% for u in users %}
    <tr>
      <td data-sort-value="{{ u.nick|lower }}">
        <a href="{{ url_for('user', {nick: u.nick}) }}">{{ u.nick }}</a>
        {% if u.oper %}<span class="tag">{{ 'oper'|t }}</span>{% endif %}
        {% if u.away %}<span class="tag tag--quiet">{{ 'away'|t }}</span>{% endif %}
        {% if u.tls %}<span class="tag tag--quiet" title="{{ 'Connected with TLS'|t }}">TLS</span>{% endif %}
      </td>
      <td class="mono small">{{ u.ident }}@{{ u.host }}</td>
      {% if cfg.display.show_realname %}<td class="small">{{ u.real|irc_strip }}</td>{% endif %}
      <td><a href="{{ url_for('server', {server: u.server}) }}">{{ u.server }}</a></td>
      {% if cfg.geoip %}<td data-sort-value="{{ u.country_name }}">{{ flag(u.country) }} {{ u.country_name ?: '—' }}</td>{% endif %}
      <td class="num" data-sort-value="{{ u.channels }}">{{ u.channels }}</td>
      <td data-sort-value="{{ u.signon }}">{{ (snapshot_time - u.signon)|duration }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
