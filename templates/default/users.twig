{% extends 'layout.twig' %}

{% block content %}
<h1>{{ 'Users'|t }}</h1>
<p class="lead">{% if cfg.display.registered_users_only %}{{ _n('%s registered user online, %s users in total.', '%s registered users online, %s users in total.', users|length)|format(users|length|format_number, total|format_number) }}{% else %}{{ _n('%s user online.', '%s users online.', users|length)|format(users|length|format_number) }}{% endif %}</p>
{% if cfg.display.registered_users_only %}<p class="note">{{ 'Only users logged in to a NickServ account are listed; the totals on this site count everyone.'|t }}</p>{% endif %}
{% if hidden.servers %}<p class="note">{{ _n('%s server is not shown on this site; its users appear without a link to it.', '%s servers are not shown on this site; their users appear without a link to them.', hidden.servers)|format(hidden.servers) }}</p>{% endif %}
<p><label for="filter" class="visually-hidden">{{ 'Filter users'|t }}</label><input id="filter" class="filter" type="search" placeholder="{{ 'Filter by nick, host or name'|t }}" data-filter-table="#users"></p>
<table id="users" class="table table--sortable table--paged">
  <thead><tr>
    <th data-sort="asc">{{ 'Nick'|t }}</th>
    <th>{{ 'Host'|t }}</th>
    {% if cfg.display.show_realname %}<th>{{ 'Real name'|t }}</th>{% endif %}
    <th>{{ 'Server'|t }}</th>
    {% if cfg.geoip %}<th>{{ 'Country'|t }}</th>{% endif %}
    <th class="num">{{ 'Channels'|t }}</th>
    <th>{{ 'Online for'|t }}</th>
  </tr></thead>
  <tbody>
  {% for u in users %}
    <tr>
      <td data-sort-value="{{ u.nick|lower }}">
        <a href="{{ url_for('user', {nick: u.nick}) }}">{{ u.nick }}</a>
        {% if u.oper %}{{ icon('shield-user', 'IRC operator'|t, 'icon--accent') }}{% endif %}
        {% if u.away %}{{ icon('moon', 'Away'|t) }}{% endif %}
        {% if u.tls %}{{ icon('lock', 'Connected with TLS'|t) }}{% endif %}
      </td>
      <td class="mono small">{{ u.ident }}@{{ u.host }}</td>
      {% if cfg.display.show_realname %}<td class="small">{{ u.real|irc_strip }}</td>{% endif %}
      <td>{% if u.server_hidden %}{{ u.server }}{% else %}<a href="{{ url_for('server', {server: u.server}) }}">{{ u.server }}</a>{% endif %}</td>
      {% if cfg.geoip %}<td class="nowrap" data-sort-value="{{ u.country_name }}">{{ flag(u.country) }} {{ u.country_name ?: '—' }}</td>{% endif %}
      <td class="num" data-sort-value="{{ u.channels }}">{{ u.channels }}</td>
      <td data-sort-value="{{ u.signon }}">{{ (snapshot_time - u.signon)|duration }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% endblock %}
