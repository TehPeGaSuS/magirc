{% extends 'layout.twig' %}

{% block content %}
<h1>{{ title }}</h1>
{% if server %}
  <p class="lead">{{ server.description|irc_strip }}</p>
  <dl class="props">
    <div><dt>{{ 'Status'|t }}</dt><dd>{% if online %}<span class="status status--on">{{ 'linked'|t }}</span>{% else %}<span class="status status--off">{{ 'offline'|t }}</span>{% endif %}</dd></div>
    {% if seen and seen.linked_since %}<div><dt>{{ 'Linked since'|t }}</dt><dd>{{ seen.linked_since|datetime }} <span class="muted">({{ seen.linked_since|since(snapshot_time) }})</span></dd></div>{% endif %}
    {% if server.uplink %}<div><dt>{{ 'Uplink'|t }}</dt><dd>{{ server.uplink }}</dd></div>{% endif %}
    <div><dt>{{ 'Users'|t }}</dt><dd class="num">{{ server.usercount }}</dd></div>
    <div><dt>{{ 'Operators'|t }}</dt><dd class="num">{{ server.opercount }}</dd></div>
  </dl>
{% else %}
  <p class="lead">{{ 'This server is not linked right now.'|t }} {% if seen %}{{ 'Last seen %s.'|t|format(seen.last_seen|ago) }}{% endif %}</p>
{% endif %}

{% if history|length > 1 %}
<section>
  <h2>{{ 'Users this week'|t }}</h2>
  <div class="chart chart--wide" data-chart="line" data-series="users" data-range="604800" data-points="{{ chart_data(history) }}" role="img" aria-label="{{ 'Users on this server over the last 7 days'|t }}"></div>
</section>
{% endif %}

{% if countries %}
<section>
  <h2>{{ 'Countries'|t }}</h2>
  {% include '_countries.twig' with {countries: countries, total: users|length} %}
</section>
{% endif %}

{% if users %}
<section>
  <h2>{{ 'Users'|t }}</h2>
  {% include '_users_table.twig' with {users: users, show_server: false} %}
</section>
{% endif %}
{% endblock %}
