{
    "name": "magirc/magirc",
    "description": "MagIRC - Web frontend for Anope IRC services statistics",
    "type": "project",
    "keywords": [ "irc", "anope", "stats", "statistics", "frontend" ],
    "homepage": "https://github.com/TehPeGaSuS/magirc",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Sebastian Vassiliou",
            "email": "h9k@users.noreply.github.com",
            "role": "Original author"
        },
        {
            "name": "PeGaSuS",
            "role": "Maintainer (2.x)"
        }
    ],
    "support": {
        "issues": "https://github.com/TehPeGaSuS/magirc/issues",
        "source": "https://github.com/TehPeGaSuS/magirc"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.21",
        "twig/intl-extra": "^3.21",
        "php-di/php-di": "^7.0",
        "gettext/gettext": "^5.7",
        "gettext/translator": "^1.2",
        "league/commonmark": "^2.6",
        "geoip2/geoip2": "^3.1",
        "symfony/console": "^7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "ext-pdo_mysql": "Required for the optional chanstats activity statistics",
        "ext-pdo_sqlite": "Default backend for MagIRC's own history store",
        "ext-maxminddb": "Faster GeoIP lookups"
    },
    "autoload": {
        "psr-4": { "Magirc\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Magirc\\Tests\\": "tests/" }
    },
    "config": {
        "sort-packages": true,
        "platform-check": true
    },
    "scripts": {
        "test": "phpunit",
        "check": "php bin/magirc check"
    }
}
